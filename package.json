{
  "name": "story-format-vscode-extension",
  "displayName": ".STORY Format Support",
  "description": "Language support and syntax highlighting for .STORY files",
  "version": "1.0.0",
  "publisher": "keane3029-lab",
  "repository": {
    "type": "git",
    "url": "https://github.com/keane3029-lab/.story-format-vscode-extension"
  },
  "engines": {
    "vscode": "^1.80.0"
  }
}

  },
  "homepage": "https://github.com/keane3029-lab/.story-format-vscode-extension",
  "bugs": {
    "url": "https://github.com/keane3029-lab/.story-format-vscode-extension/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Snippets"],
  "keywords": ["story", "interactive-fiction", "dialogue", "syntax", "parser"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "story",
        "aliases": ["STORY", "story"],
        "extensions": [".story", ".STORY"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "story",
        "scopeName": "source.story",
        "path": "./syntaxes/story.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "story",
        "path": "./snippets/story.code-snippets"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
